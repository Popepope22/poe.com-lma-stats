                <div class="bg-white rounded-lg p-4 border-[#5D5CDE] border-2">
                    <div class="flex justify-between items-center mb-3">
                        <div><h4 class="font-bold text-gray-900">Group 3 </h4><p class="text-sm text-gray-600">Manager: Bićko 🐳</p></div>
                        <div class="flex gap-2">
                            <button onclick="editGroup(1, 1789193818829)" class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm px-3 py-1 rounded-md">Edit</button>
                            <button onclick="assignChatterToGroup(1, 1789193818829)" class="bg-green-500 hover:bg-green-600 text-white text-sm px-3 py-1 rounded-md">+ Assign</button>
