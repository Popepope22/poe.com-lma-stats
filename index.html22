psis; vertical-align: middle;">$431.02</td><td colspan="7" class="px-1 py-1 bg-gray-50"></td></tr><tr class="bg-gray-50/50"><td class="px-1 py-1 text-gray-600 bg-blue-50 font-medium border-l border-blue-400 border-b border-blue-400" style="border-left-width: 2px; border-bottom-width: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Avg Response</td><td class="px-1 py-1 text-center text-gray-600 font-semibold italic bg-yellow-50 border-b border-blue-400" style="border-bottom-width: 1px;">&lt; 6m</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-blue-50 border-b border-blue-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-blue-50 border-b border-blue-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-blue-50 border-b border-blue-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-blue-50 border-b border-blue-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center font-bold text-gray-900 bg-blue-50 border-r border-blue-400 border-b border-blue-400" style="border-right-width: 2px; border-bottom-width: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle;">-</td><td class="px-1 py-1 text-gray-600 bg-green-50 font-medium border-l border-green-400 border-b border-green-400" style="border-left-width: 2px; border-bottom-width: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Avg Response</td><td class="px-1 py-1 text-center text-gray-600 font-semibold italic bg-yellow-50 border-b border-green-400" style="border-bottom-width: 1px;">&lt; 6m</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-green-50 border-b border-green-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-green-50 border-b border-green-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-green-50 border-b border-green-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center text-gray-900 font-normal bg-green-50 border-b border-green-400" style="border-bottom-width: 1px; white-space: nowrap; vertical-align: middle;">-</td><td class="px-1 py-1 text-center font-bold text-gray-900 bg-green-50 border-r border-green-400 border-b border-green-400" style="border-right-width: 2px; border-bottom-width: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle;">-</td><td colspan="7" class="px-1 py-1 bg-gray-50"></td></tr></tbody></table></div></div>
                                <div class="flex gap-2 justify-end no-print mt-2 -mr-1 -mb-1">
                                    <button onclick="downloadGroupImage(this, &#39;group-report-1-1789193936010-section-0&#39;, &#39;chatting_coach_tl_sect1&#39;)" class="bg-blue-500 hover:bg-blue-600 text-white text-xs font-semibold py-1 px-2 rounded">Download</button>
                                    <button onclick="copyGroupImage(this, &#39;group-report-1-1789193936010-section-0&#39;)" class="bg-green-500 hover:bg-green-600 text-white text-xs font-semibold py-1 px-2 rounded">Copy</button>
                                </div></div></div></div></div></div>
        </div>

        <div id="error-container" class="hidden">
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <p class="text-red-800 font-medium">Error</p>
                <p id="error-message" class="text-red-600 text-sm mt-1"></p>
            </div>
        </div>
    </div>

    <script>
        // --- DEFAULT TARGETS ---
        const DEFAULT_TARGETS = {
            messagesSent: 0,
            fansChatted: 0,
            ppvsSent: 0,
            ppvsOpen: 0,
            revenue: 0,
            responseTime: 6
        };

        // Data storage
        let quarterData = { q1: null, q2: null, q3: null, q4: null };
        let allChatters = [];
        let allModels = {};
        let shiftAllocations = { 1: { groups: [] }, 2: { groups: [] }, 3: { groups: [] } };
        let chatterModels = {};
        let selectedChattersForAssignment = [];
        let allocationsLocked = false;
        
        let modelVisibility = {}; 
        let modelTargets = {};    
        let modelSlowExclude = {};

        // --- PERSISTENCE FUNCTIONS ---
        function saveData() {
            try {
                const dataToSave = {
                    quarterData,
                    shiftAllocations,
                    modelVisibility,
                    modelTargets,
                    modelSlowExclude,
                    allocationsLocked
                };
                localStorage.setItem('chatterTrackerData', JSON.stringify(dataToSave));
                
                const indicator = document.getElementById('save-indicator');
                if (indicator) {
                    indicator.style.opacity = '1';
                    setTimeout(() => { indicator.style.opacity = '0'; }, 2000);
                }
            } catch (e) {
                console.warn('Failed to save to local storage (likely quota exceeded or private browsing):', e);
            }
        }

        function loadData() {
            const json = localStorage.getItem('chatterTrackerData');
            if (!json) return;
            try {
                const saved = JSON.parse(json);
                quarterData = saved.quarterData || { q1: null, q2: null, q3: null, q4: null };
                
                if (saved.shiftAllocations) {
                    shiftAllocations[1] = saved.shiftAllocations[1] || { groups: [] };
                    shiftAllocations[2] = saved.shiftAllocations[2] || { groups: [] };
                    shiftAllocations[3] = saved.shiftAllocations[3] || { groups: [] };
                }

                modelVisibility = saved.modelVisibility || {};
                modelTargets = saved.modelTargets || {};
                modelSlowExclude = saved.modelSlowExclude || {};
                allocationsLocked = saved.allocationsLocked || false;

                ['q1', 'q2', 'q3', 'q4'].forEach(q => {
                    if (quarterData[q] && Array.isArray(quarterData[q]) && quarterData[q].length > 0) {
                        const statusEl = document.getElementById(`${q}-status`);
                        if (statusEl) {
                            statusEl.textContent = '✓ (Restored)';
                            statusEl.className = 'text-xs text-blue-600 font-semibold';
                        }
                    }
                });

                if (quarterData.q1 || quarterData.q2 || quarterData.q3 || quarterData.q4) {
                    rebuildDataStructures();
                    const allocSec = document.getElementById('allocation-section');
                    if (allocSec) allocSec.classList.remove('hidden');
                    
                    if (allocationsLocked) {
                        updateAllocationStatus();
                        generateReport();
                    } else {
                        initializeAllocation();
                    }
                }

            } catch (e) {
                console.error("Failed to load saved data", e);
            }
        }

        // --- IMPORT/EXPORT LOGIC ---
        function exportPersistence() {
            saveData();
            const data = localStorage.getItem('chatterTrackerData');
            if (!data) {
                showCustomAlert("No data found in memory to export. Please process files first.");
                return;
            }
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            const date = new Date().toISOString().split('T')[0];
            a.href = url;
            a.download = `chatter_tracker_backup_${date}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function importPersistence(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedContent = e.target.result;
                    const parsed = JSON.parse(importedContent);
                    if (!parsed.quarterData && !parsed.shiftAllocations) {
                        throw new Error("This file doesn't look like a valid Chatter Tracker backup.");
                    }
                    const confirmImport = confirm("Importing this file will overwrite your current data. Proceed?");
                    if (confirmImport) {
                        localStorage.setItem('chatterTrackerData', importedContent);
                        window.location.reload();
                    }
                } catch (err) {
                    showCustomAlert("Error importing file: " + err.message);
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        // --- TIME PARSING ---
        function parseTimeDuration(timeStr) {
            if (timeStr === undefined || timeStr === null) return 0;
            timeStr = timeStr.toString().toLowerCase().trim();
            if (timeStr === '-' || timeStr === '') return 0;
            let minutes = 0;
            const h = timeStr.match(/(\d+)\s*h/);
            const m = timeStr.match(/(\d+)\s*m/);
            const s = timeStr.match(/(\d+)\s*s/);
            if (h) minutes += parseInt(h[1]) * 60;
            if (m) minutes += parseInt(m[1]);
            if (s) minutes += parseInt(s[1]) / 60;
            if (!h && !m && !s && !isNaN(parseFloat(timeStr))) minutes = parseFloat(timeStr);
            return minutes;
        }

        function formatTimeDuration(totalMinutes) {
            if (totalMinutes === 0 || totalMinutes === undefined || totalMinutes === null) return "-";
            const m = Math.floor(totalMinutes);
            const s = Math.round((totalMinutes - m) * 60);
            if (m === 0 && s === 0) return "0m 0s";
            return `${m}m ${s}s`;
        }

        // --- CSV PARSING ---
        function parseCSV(file) {
            return new Promise((resolve, reject) => {
                Papa.parse(file, {
                    header: true,
                    skipEmptyLines: true,
                    complete: (results) => resolve(results.data),
                    error: (error) => reject(error)
                });
            });
        }

        function processData(data, quarterName) {
            const processed = {};
            let revenueKey = null;
            let responseTimeKey = null;

            if (data && data.length > 0) {
                const keys = Object.keys(data[0]);
                const priorities = ['sales', 'total net earnings', 'earnings', 'gross earnings'];
                for (const p of priorities) {
                    const found = keys.find(k => k.toLowerCase().trim() === p);
                    if (found) { revenueKey = found; break; }
                }
                if (!revenueKey) revenueKey = keys.find(k => k.toLowerCase().includes('sales')) || keys.find(k => k.toLowerCase().includes('revenue'));
                responseTimeKey = keys.find(k => k.toLowerCase().includes('response time'));
            }

            if (!Array.isArray(data)) return [];

            data.forEach(row => {
                if (!row) return;
                const chatter = row['Employees'] ? row['Employees'].toString().trim() : '';
                const model = row['Creators'] ? row['Creators'].toString().trim() : '';
                const messagesSent = parseInt(row['Direct messages sent']) || 0;
                const ppvsSent = parseInt(row['Direct PPVs sent']) || 0;
                const ppvsOpen = parseInt(row['PPVs unlocked']) || 0;
                const fansChatted = parseInt(row['Fans chatted']) || 0;
                
                let revenue = 0;
                if (revenueKey && row[revenueKey] !== undefined && row[revenueKey] !== null) {
                    revenue = parseFloat(row[revenueKey].toString().replace(/[^0-9.-]+/g, "")) || 0;
                }

                let responseTime = 0;
                let hasValidResponse = false;
                if (responseTimeKey && row[responseTimeKey] !== undefined && row[responseTimeKey] !== null) {
                    const val = row[responseTimeKey].toString();
                    if (val.trim() !== '-' && val.trim() !== '') {
                        responseTime = parseTimeDuration(val);
                        hasValidResponse = true;
                    }
                }

                if (!chatter || !model) return;

                const key = `${chatter}|||${model}`;
                if (!processed[key]) {
                    processed[key] = {
                        chatter, model, fansChatted, messagesSent, ppvsSent, ppvsOpen, revenue,
                        responseTimeSum: hasValidResponse ? responseTime : 0,
                        responseCount: hasValidResponse ? 1 : 0
                    };
                } else {
                    processed[key].fansChatted += fansChatted;
                    processed[key].messagesSent += messagesSent;
                    processed[key].ppvsSent += ppvsSent;
                    processed[key].ppvsOpen += ppvsOpen;
                    processed[key].revenue += revenue;
                    if (hasValidResponse) {
                        processed[key].responseTimeSum += responseTime;
                        processed[key].responseCount += 1;
                    }
                }
            });
            return Object.values(processed);
        }

        const modelColors = [
            { bg: 'bg-blue-50', border: 'border-blue-400', text: 'text-blue-900' },
            { bg: 'bg-green-50', border: 'border-green-400', text: 'text-green-900' },
            { bg: 'bg-purple-50', border: 'border-purple-400', text: 'text-purple-900' },
            { bg: 'bg-orange-50', border: 'border-orange-400', text: 'text-orange-900' },
            { bg: 'bg-pink-50', border: 'border-pink-400', text: 'text-pink-900' },
            { bg: 'bg-teal-50', border: 'border-teal-400', text: 'text-teal-900' },
            { bg: 'bg-indigo-50', border: 'border-indigo-400', text: 'text-indigo-900' },
            { bg: 'bg-rose-50', border: 'border-rose-400', text: 'text-rose-900' }
        ];

        function createChatterTable(chatter, modelsData, quarterLabels) {
            modelsData.sort((a, b) => a.model.localeCompare(b.model));
            const maxQuarters = 4;
            const allQuarterSlots = ['Q1', 'Q2', 'Q3', 'Q4'];
            const modelsPerRow = 3;
            const modelRows = [];
            for (let i = 0; i < modelsData.length; i += modelsPerRow) modelRows.push(modelsData.slice(i, i + modelsPerRow));

            const slowExclusions = modelSlowExclude[chatter] || {};
            const thresholdMinutes = 3 + (20 / 60);
            const slowModelsSet = new Set();

            modelsData.forEach(m => {
                const isSlowExcluded = slowExclusions[m.model] === true;

                if (!isSlowExcluded && m.quarters && Array.isArray(m.quarters)) {
                    // Find the latest active quarter with response data
                    let latestQuarterData = null;
                    for (let i = m.quarters.length - 1; i >= 0; i--) {
                        if (m.quarters[i] && m.quarters[i].responseCount > 0) {
                            latestQuarterData = m.quarters[i];
                            break;
                        }
                    }

                    if (latestQuarterData) {
                        const quarterAvg = latestQuarterData.responseTimeSum / latestQuarterData.responseCount;
                        if (quarterAvg >= thresholdMinutes) {
                            slowModelsSet.add(m.model);
                        }
                    }
                }
            });

            // Keep header background static (#5D5CDE)
            const headerBgClass = 'bg-[#5D5CDE]';
            
            // Generate list badge for slow models centered below the chatter name
            let slowModelsBadge = '';
            if (slowModelsSet.size > 0) {
                const slowList = Array.from(slowModelsSet).join(', ');
                slowModelsBadge = `<div class="w-full flex justify-center mt-1"><span class="bg-red-500 text-white text-xs font-semibold px-2 py-0.5 rounded shadow-sm flex items-center gap-1" title="High Response Time Detected">⚠️ Slow Response: ${slowList}</span></div>`;
            }

            let html = `
                <div class="bg-white rounded border border-gray-300 mb-2 break-inside-avoid shadow-sm">
                    <div class="${headerBgClass} text-white px-3 py-2 flex flex-col items-center relative">
                        <div class="flex items-center justify-between w-full">
                            <div class="w-16"></div>
                            <h4 class="text-lg font-bold text-center flex-1">${chatter}</h4>
                            <span class="text-xs opacity-75 w-16 text-right">${modelsData.length} model${modelsData.length > 1 ? 's' : ''}</span>
                        </div>
                        ${slowModelsBadge}
                    </div>`;

            modelRows.forEach((rowModels, rowIdx) => {
                while (rowModels.length < modelsPerRow) rowModels.push(null);
                html += `<div class="overflow-x-auto"><table class="w-full text-xs table-fixed" style="border-collapse: separate; border-spacing: 0;"><thead class="bg-gray-100"><tr>`;
                
                rowModels.forEach((modelEntry, idx) => {
                    const colorIdx = (rowIdx * modelsPerRow + idx) % modelColors.length;
                    const color = modelColors[colorIdx];
                    if (modelEntry) {
                        const isExcludedModel = slowExclusions[modelEntry.model] === true;
                        const excludedTag = isExcludedModel ? '<span class="text-[10px] bg-gray-200 text-gray-600 font-normal px-1 rounded ml-1" title="Excluded from slow response detection">Excl</span>' : '';

                        html += `<th rowspan="2" class="px-1 py-1 text-left font-bold text-sm ${color.text} ${color.bg} border-b border-l border-t ${color.border}" style="width: 10%; border-width: 2px; white-space: nowrap;">${modelEntry.model}${excludedTag}</th>
                                 <th class="px-1 py-1 text-center font-bold text-yellow-800 italic bg-yellow-50 border-b border-t border-gray-300" style="width: 5%; border-width: 1px;">Target</th>`;
                        allQuarterSlots.forEach(q => { html += `<th class="px-1 py-1 text-center font-semibold text-gray-700 ${color.bg} border-b border-t border-gray-300" style="width: 4.5%; border-width: 1px; white-space: nowrap;">${q}</th>`; });
                        html += `<th class="px-1 py-1 text-center font-semibold text-gray-700 ${color.bg} border-b border-t border-r ${color.border}" style="width: 6.5%; border-width: 2px; white-space: nowrap;">Total</th>`;
                    } else {
                        html += `<th colspan="${maxQuarters + 3}" class="px-1 py-1 bg-gray-50 border-b border-gray-300" style="width: 33.33%; border-width: 1px;"></th>`;
                    }
                });

                html += `</tr></thead><tbody>`;

                const metricKeys = [
                    { label: 'Fans chatted', key: 'fansChatted' },
                    { label: 'Messages sent', key: 'messagesSent' },
                    { label: 'PPVs sent', key: 'ppvsSent' },
                    { label: 'PPVs open', key: 'ppvsOpen' },
                    { label: 'Revenue', key: 'revenue', isCurrency: true },
                    { label: 'Avg Response', key: 'responseTimeSum', isTime: true }
                ];

                metricKeys.forEach((metricDef, metricIdx) => {
                    const isLastMetric = metricIdx === metricKeys.length - 1;
                    const rowBg = metricIdx % 2 === 0 ? '' : 'bg-gray-50/50';
                    html += `<tr class="${rowBg}">`;

                    rowModels.forEach((modelEntry, idx) => {
                        const colorIdx = (rowIdx * modelsPerRow + idx) % modelColors.length;
                        const color = modelColors[colorIdx];

                        if (modelEntry) {
                            const bottomBorder = isLastMetric ? `border-b ${color.border}` : '';
                            const specificTargets = modelTargets[modelEntry.model] || DEFAULT_TARGETS;
                            const targetKey = metricDef.isTime ? 'responseTime' : metricDef.key;
                            const targetValue = specificTargets[targetKey];
                            
                            html += `<td class="px-1 py-1 text-gray-600 ${color.bg} font-medium border-l ${color.border} ${bottomBorder}" style="border-left-width: 2px; ${isLastMetric ? 'border-bottom-width: 2px;' : ''} white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${metricDef.label}</td>`;
                            
                            let targetDisplay = targetValue;
                            if (metricDef.isCurrency) targetDisplay = `$${targetValue}`;
                            if (metricDef.isTime) targetDisplay = `< ${targetValue}m`;
                            html += `<td class="px-1 py-1 text-center text-gray-600 font-semibold italic bg-yellow-50 ${bottomBorder}" style="${isLastMetric ? 'border-bottom-width: 1px;' : ''}">${targetDisplay}</td>`;

                            let totalSum = 0; let totalCount = 0;
                            allQuarterSlots.forEach((quarterSlot, slotIdx) => {
                                const quarterIdx = quarterLabels.indexOf(quarterSlot);
                                let value = 0; let isValidTime = false;
                                
                                if (quarterIdx >= 0 && modelEntry.quarters && modelEntry.quarters[quarterIdx]) {
                                    const qData = modelEntry.quarters[quarterIdx];
                                    if (metricDef.isTime) {
                                        if (qData.responseCount > 0) {
                                            value = qData.responseTimeSum / qData.responseCount;
                                            isValidTime = true;
                                            totalSum += qData.responseTimeSum;
                                            totalCount += qData.responseCount;
                                        }
                                    } else {
                                        value = qData[metricDef.key] || 0;
                                        totalSum += value;
                                    }
                                }

                                let displayValue = value;
                                if (metricDef.isCurrency) displayValue = `$${value.toFixed(0)}`;
                                if (metricDef.isTime) displayValue = isValidTime ? formatTimeDuration(value) : '-';
                                else if (value === 0) displayValue = '-';
                                
                                let textColor = 'text-gray-900'; 
                                let fontWeight = 'font-normal';
                                
                                let previousValue = null;
                                if (slotIdx > 0) {
                                    for (let prevIdx = slotIdx - 1; prevIdx >= 0; prevIdx--) {
                                        const prevQSlot = allQuarterSlots[prevIdx];
                                        const prevQIdx = quarterLabels.indexOf(prevQSlot);
                                        if (prevQIdx >= 0 && modelEntry.quarters && modelEntry.quarters[prevQIdx]) {
                                            const prevData = modelEntry.quarters[prevQIdx];
                                            if (metricDef.isTime) {
                                                if (prevData.responseCount > 0) {
                                                    previousValue = prevData.responseTimeSum / prevData.responseCount;
                                                    break;
                                                }
                                            } else {
                                                previousValue = prevData[metricDef.key] || 0;
                                                break;
                                            }
                                        }
                                    }
                                }

                                const hasData = metricDef.isTime ? isValidTime : value > 0;
                                if (hasData) {
                                    if (metricDef.isTime) {
                                        const maxAllowedTime = 3 + (20 / 60);
                                        if (value >= maxAllowedTime) {
                                            textColor = 'text-red-600';
                                            fontWeight = 'font-bold';
                                        } else {
                                            textColor = 'text-green-600';
                                            fontWeight = 'font-bold';
                                        }
                                    } 
                                    else if (slotIdx === 0) {
                                        const bad = value < targetValue;
                                        textColor = bad ? 'text-red-600' : 'text-green-600';
                                        fontWeight = 'font-bold';
                                    } 
                                    else if (previousValue !== null) {
                                        if (value > previousValue) { 
                                            textColor = 'text-green-600'; 
                                            fontWeight = 'font-bold'; 
                                        } else if (value < previousValue) { 
                                            textColor = 'text-red-600'; 
                                            fontWeight = 'font-bold'; 
                                        } else { 
                                            textColor = 'text-yellow-600'; 
                                            fontWeight = 'font-bold'; 
                                        }
                                    } else {
                                        const bad = value < targetValue;
                                        textColor = bad ? 'text-red-600' : 'text-green-600';
                                        fontWeight = 'font-bold';
                                    }
                                }

                                html += `<td class="px-1 py-1 text-center ${textColor} ${fontWeight} ${color.bg} ${bottomBorder}" style="${isLastMetric ? 'border-bottom-width: 1px;' : ''} white-space: nowrap; vertical-align: middle;">${displayValue}</td>`;
                            });

                            let finalTotal = totalSum;
                            if (metricDef.isTime && totalCount > 0) finalTotal = totalSum / totalCount;
                            let displayTotal = finalTotal;
                            if (metricDef.isCurrency) displayTotal = `$${finalTotal.toFixed(2)}`;
                            if (metricDef.isTime) displayTotal = totalCount > 0 ? formatTimeDuration(finalTotal) : '-';

                            html += `<td class="px-1 py-1 text-center font-bold text-gray-900 ${color.bg} border-r ${color.border} ${bottomBorder}" style="border-right-width: 2px; ${isLastMetric ? 'border-bottom-width: 2px;' : ''} white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle;">${displayTotal}</td>`;
                        } else {
                            html += `<td colspan="${maxQuarters + 3}" class="px-1 py-1 bg-gray-50"></td>`;
                        }
                    });
                    html += `</tr>`;
                });
                html += `</tbody></table></div>`;
            });
            html += `</div>`;
            return html;
        }

        function rebuildDataStructures() {
            const quarters = ['q1', 'q2', 'q3', 'q4'];
            const allChattersSet = new Set();
            quarters.forEach(q => {
                if (quarterData && quarterData[q] && Array.isArray(quarterData[q])) {
                    quarterData[q].forEach(entry => {
                        if (entry && entry.chatter) allChattersSet.add(entry.chatter);
                    });
                }
            });

            allChatters = Array.from(allChattersSet).sort();
            chatterModels = {};
            allModels = {};

            allChatters.forEach(chatter => {
                const models = new Set();
                quarters.forEach(q => {
                    if (quarterData && quarterData[q] && Array.isArray(quarterData[q])) {
                        quarterData[q].forEach(entry => {
                            if (entry && entry.chatter === chatter) models.add(entry.model);
                        });
                    }
                });
                
                allModels[chatter] = Array.from(models);
                
                chatterModels[chatter] = Array.from(models).map(model => {
                    const quarterValues = quarters.map((q, idx) => {
                        if (quarterData && quarterData[q] && Array.isArray(quarterData[q])) {
                            const found = quarterData[q].find(e => e && e.chatter === chatter && e.model === model);
                            return found || null;
                        }
                        return null;
                    });

                    return { model, quarters: quarterValues };
                });
            });
        }

        async function processAllFiles() {
            const errorContainer = document.getElementById('error-container');
            const errorMessage = document.getElementById('error-message');
            const allocationSection = document.getElementById('allocation-section');
            document.getElementById('debug-banner').innerHTML = ""; 
            document.getElementById('debug-banner').classList.add('hidden');
            errorContainer.classList.add('hidden');
            
            try {
                const quarters = ['q1', 'q2', 'q3', 'q4'];
                let hasNewData = false;

                for (let i = 0; i < quarters.length; i++) {
                    const fileInput = document.getElementById(`file-${quarters[i]}`);
                    const statusEl = document.getElementById(`${quarters[i]}-status`);
                    
                    if (fileInput && fileInput.files.length > 0) {
                        const data = await parseCSV(fileInput.files[0]);
                        quarterData[quarters[i]] = processData(data, `Q${i+1}`);
                        statusEl.textContent = '✓ (New)';
                        statusEl.className = 'text-xs text-green-600';
                        hasNewData = true;
                    }
                }

                if (!hasNewData && !quarterData.q1 && !quarterData.q2 && !quarterData.q3 && !quarterData.q4) {
                    throw new Error('Please upload at least one CSV file or check if previous data was restored.');
                }

                rebuildDataStructures();
                saveData();
                updateAllocationStatus();
                allocationSection.classList.remove('hidden');
                initializeAllocation();

            } catch (error) {
                errorMessage.textContent = error.message;
                errorContainer.classList.remove('hidden');
            }
        }

        function updateAllocationStatus() {
            const statusEl = document.getElementById('allocation-status');
            if (!statusEl) return;
            if (allocationsLocked) {
                statusEl.textContent = '✓ Allocations Locked';
                statusEl.className = 'text-sm font-semibold text-green-600';
            } else {
                statusEl.textContent = '';
            }
        }

        function initializeAllocation() {
            if (allocationsLocked) {
                for (let shift = 1; shift <= 3; shift++) renderGroups(shift);
                const lockBtn = document.getElementById('lock-allocations-btn');
                if (lockBtn) {
                    lockBtn.textContent = 'Allocations Locked - Processing Data';
                    lockBtn.classList.add('opacity-50', 'cursor-not-allowed');
                }
                return;
            }
            for (let shift = 1; shift <= 3; shift++) {
                renderUnassignedChatters(shift);
                renderGroups(shift);
            }
        }

        function lockAllocations() {
            if (allocationsLocked) {
                generateReport();
                return;
            }
            let hasAllocations = false;
            for (let shift = 1; shift <= 3; shift++) {
                if (shiftAllocations[shift].groups.some(g => g.chatters.length > 0)) {
                    hasAllocations = true;
                    break;
                }
            }
            if (!hasAllocations) {
                showCustomAlert('Please allocate at least one chatter to a group before locking.');
                return;
            }
            allocationsLocked = true;
            saveData();
            generateReport();
        }

        function resetAllocations() {
            const modal = document.createElement('div');
            modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            modal.innerHTML = `
                <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full mx-4">
                    <p class="text-gray-700 mb-4 font-semibold">Reset all groupings and allocations?</p>
                    <div class="flex justify-end gap-3">
                        <button class="px-4 py-2 bg-gray-500 text-white hover:bg-gray-600 rounded" onclick="this.closest('.fixed').remove()">Cancel</button>
                        <button class="px-4 py-2 bg-red-500 text-white hover:bg-red-600 rounded" onclick="confirmReset(); this.closest('.fixed').remove()">Reset</button>
                    </div>
                </div>`;
            document.body.appendChild(modal);
        }

        function confirmReset() {
            shiftAllocations[1].groups = [];
            shiftAllocations[2].groups = [];
            shiftAllocations[3].groups = [];
            allocationsLocked = false;
            const lockBtn = document.getElementById('lock-allocations-btn');
            if (lockBtn) {
                lockBtn.textContent = 'Lock Allocations & View Report';
                lockBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
            updateAllocationStatus();
            saveData();
            initializeAllocation();
        }

        function renderUnassignedChatters(shift) {
            const container = document.getElementById(`shift-${shift}-unassigned`);
            if (!container) return;
            const assignedChatters = new Set();
            shiftAllocations[shift].groups.forEach(group => group.chatters.forEach(c => assignedChatters.add(c)));
            const unassigned = allChatters.filter(c => !assignedChatters.has(c));
            const searchInput = document.getElementById(`chatter-search-input-${shift}`);
            const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
            const filteredUnassigned = unassigned.filter(c => c.toLowerCase().includes(searchTerm));

            if (filteredUnassigned.length === 0) {
                container.innerHTML = searchTerm ? `<p class="text-gray-500 text-sm">No chatters found matching "${searchTerm}"</p>` : '<p class="text-gray-500 text-sm">All chatters have been assigned</p>';
                return;
            }

            const isAssignmentMode = currentAssignmentShift === shift;
            container.innerHTML = filteredUnassigned.map(chatter => {
                const isSelected = selectedChattersForAssignment.includes(chatter);
                const bgClass = isAssignmentMode ? (isSelected ? 'bg-[#5D5CDE]' : 'bg-green-200') : 'bg-gray-200';
                const hoverClass = isAssignmentMode ? (isSelected ? 'hover:bg-[#4D4CCE]' : 'hover:bg-green-300') : 'hover:bg-gray-300';
                const textColor = isSelected ? 'text-white' : 'text-gray-800';
                return `<span class="chatter-tag ${bgClass} ${textColor} px-3 py-2 rounded-md text-sm cursor-pointer ${hoverClass}" data-chatter="${chatter}">${chatter}${isSelected ? ' ✓' : ''}</span>`;
            }).join('');

            if (isAssignmentMode && currentAssignmentGroupId) {
                container.querySelectorAll('.chatter-tag').forEach(tag => {
                    tag.onclick = () => {
                        const chatter = tag.dataset.chatter;
                        if (selectedChattersForAssignment.includes(chatter)) selectedChattersForAssignment = selectedChattersForAssignment.filter(c => c !== chatter);
                        else selectedChattersForAssignment.push(chatter);
                        renderUnassignedChatters(shift);
                        updateAssignmentBanner(shift);
                    };
                });
            }
        }

        function addGroup(shift) {
            const groupNameInput = document.getElementById(`shift-${shift}-group-name`);
            const managerNameInput = document.getElementById(`shift-${shift}-manager-name`);
            const groupName = groupNameInput.value.trim();
            const managerName = managerNameInput.value.trim();

            if (!groupName || !managerName) {
                showCustomAlert('Please enter both group name and manager name');
                return;
            }

            const group = { id: Date.now(), name: groupName, manager: managerName, chatters: [] };
            shiftAllocations[shift].groups.push(group);
            groupNameInput.value = '';
            managerNameInput.value = '';
            saveData();
            renderGroups(shift);
        }

        function editGroup(shift, groupId) {
            const group = shiftAllocations[shift].groups.find(g => g.id === groupId);
            if (!group) return;
            const modal = document.createElement('div');
            modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            modal.id = 'edit-group-modal';
            modal.innerHTML = `
                <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full mx-4">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Edit Group</h3>
                    <div class="space-y-3">
                        <div><label class="block text-sm font-medium text-gray-700">Group Name</label><input type="text" id="modal-group-name" value="${group.name}" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-gray-900"></div>
                        <div><label class="block text-sm font-medium text-gray-700">Manager Name</label><input type="text" id="modal-manager-name" value="${group.manager}" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-gray-900"></div>
                    </div>
                    <div class="flex justify-end gap-3 mt-5">
                        <button class="px-4 py-2 bg-gray-500 text-white hover:bg-gray-600 rounded" onclick="document.getElementById('edit-group-modal').remove()">Cancel</button>
                        <button class="px-4 py-2 bg-[#5D5CDE] text-white hover:bg-[#4D4CCE] rounded" onclick="confirmEditGroup(${shift}, ${group.id})">Save</button>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            document.getElementById('modal-group-name').focus();
        }

        function confirmEditGroup(shift, groupId) {
            const group = shiftAllocations[shift].groups.find(g => g.id === groupId);
            if (!group) return;
            const newName = document.getElementById('modal-group-name').value.trim();
            const newManager = document.getElementById('modal-manager-name').value.trim();
            if (!newName || !newManager) { showCustomAlert('Fields cannot be empty.'); return; }
            group.name = newName;
            group.manager = newManager;
            document.getElementById('edit-group-modal').remove();
            saveData();
            renderGroups(shift);
        }

        function renderGroups(shift) {
            const container = document.getElementById(`shift-${shift}-groups`);
            if (!container) return;
            container.innerHTML = shiftAllocations[shift].groups.map(group => {
                const isActive = currentAssignmentGroupId === group.id && currentAssignmentShift === shift;
                const borderClass = isActive ? 'border-green-500 border-4 shadow-lg' : 'border-[#5D5CDE] border-2';
                return `
                <div class="bg-white rounded-lg p-4 ${borderClass}">
                    <div class="flex justify-between items-center mb-3">
                        <div><h4 class="font-bold text-gray-900">${group.name} ${isActive ? '← ACTIVE' : ''}</h4><p class="text-sm text-gray-600">Manager: ${group.manager}</p></div>
                        <div class="flex gap-2">
                            <button onclick="editGroup(${shift}, ${group.id})" class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm px-3 py-1 rounded-md">Edit</button>
                            <button onclick="assignChatterToGroup(${shift}, ${group.id})" class="bg-green-500 hover:bg-green-600 text-white text-sm px-3 py-1 rounded-md">+ Assign</button>
                            <button onclick="removeGroup(${shift}, ${group.id})" class="bg-red-500 hover:bg-red-600 text-white text-sm px-3 py-1 rounded-md">Remove</button>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        ${group.chatters.length > 0 ? group.chatters.map(chatter => 
                            `<span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">${chatter}
                                <button onclick="manageChatterModels(${shift}, ${group.id}, '${chatter}')" class="hover:text-yellow-300 text-xs" title="Manage Models & Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(${shift}, ${group.id}, '${chatter}')" class="hover:text-red-300">×</button>
                            </span>`
                        ).join('') : '<p class="text-gray-500 text-sm italic">No chatters assigned yet</p>'}
                    </div>
                </div>`;
            }).join('');
            renderUnassignedChatters(shift);
        }

        let currentAssignmentShift = null;
        let currentAssignmentGroupId = null;

        function assignChatterToGroup(shift, groupId) {
            currentAssignmentShift = shift;
            currentAssignmentGroupId = groupId;
            selectedChattersForAssignment = [];
            renderGroups(shift);
            updateAssignmentBanner(shift);
            renderUnassignedChatters(shift);
        }

        function updateAssignmentBanner(shift) {
            const container = document.getElementById(`shift-${shift}-unassigned`);
            if (!container) return;
            const existingBanner = document.getElementById('assignment-banner');
            if (existingBanner) existingBanner.remove();
            const group = shiftAllocations[shift].groups.find(g => g.id === currentAssignmentGroupId);
            if (!group) return;
            const assignedChatters = new Set();
            shiftAllocations[shift].groups.forEach(g => g.chatters.forEach(c => assignedChatters.add(c)));
            const unassigned = allChatters.filter(c => !assignedChatters.has(c));
            const selectedCount = selectedChattersForAssignment.length;

            const banner = document.createElement('div');
            banner.id = 'assignment-banner';
            banner.className = 'bg-green-100 border-2 border-green-500 rounded-lg p-3 mb-3 space-y-3';
            banner.innerHTML = `
                <div class="flex justify-between items-center gap-4">
                    <div><p class="text-green-800 font-semibold">Assigning to "${group.name}"</p><p class="text-green-700 text-sm mt-1">Click chatters to select (${selectedCount} selected)</p></div>
                    <div class="flex gap-2">
                        ${unassigned.length > 0 ? `<button onclick="selectAllUnassigned(${shift})" class="bg-blue-500 hover:bg-blue-600 text-white text-sm px-3 py-2 rounded-md">Select All</button>` : ''}
                        ${selectedCount > 0 ? `<button onclick="deselectAll(${shift})" class="bg-orange-500 hover:bg-orange-600 text-white text-sm px-3 py-2 rounded-md">Clear</button>` : ''}
                        ${selectedCount > 0 ? `<button onclick="confirmAssignment(${shift})" class="bg-[#5D5CDE] hover:bg-[#4D4CCE] text-white font-semibold px-4 py-2 rounded-md">Assign</button>` : ''}
                        <button onclick="cancelAssignment(${shift})" class="bg-gray-500 hover:bg-gray-600 text-white font-semibold px-4 py-2 rounded-md">Cancel</button>
                    </div>
                </div>
                <div><input type="text" id="chatter-search-input-${shift}" oninput="renderUnassignedChatters(${shift})" placeholder="Type to search..." class="w-full px-4 py-2 text-base border border-gray-300 rounded-md bg-white text-gray-900"></div>`;
            container.parentElement.insertBefore(banner, container);
            document.getElementById(`chatter-search-input-${shift}`).focus();
        }

        function selectAllUnassigned(shift) {
            const assignedChatters = new Set();
            shiftAllocations[shift].groups.forEach(g => g.chatters.forEach(c => assignedChatters.add(c)));
            selectedChattersForAssignment = allChatters.filter(c => !assignedChatters.has(c));
            renderUnassignedChatters(shift);
            updateAssignmentBanner(shift);
        }

        function deselectAll(shift) {
            selectedChattersForAssignment = [];
            renderUnassignedChatters(shift);
            updateAssignmentBanner(shift);
        }

        function confirmAssignment(shift) {
            const group = shiftAllocations[shift].groups.find(g => g.id === currentAssignmentGroupId);
            if (group && selectedChattersForAssignment.length > 0) {
                selectedChattersForAssignment.forEach(chatter => {
                    if (!group.chatters.includes(chatter)) group.chatters.push(chatter);
                });
            }
            selectedChattersForAssignment = [];
            currentAssignmentShift = null;
            currentAssignmentGroupId = null;
            if (document.getElementById('assignment-banner')) document.getElementById('assignment-banner').remove();
            saveData();
            renderGroups(shift);
        }

        function cancelAssignment(shift) {
            selectedChattersForAssignment = [];
            currentAssignmentShift = null;
            currentAssignmentGroupId = null;
            if (document.getElementById('assignment-banner')) document.getElementById('assignment-banner').remove();
            renderGroups(shift);
            renderUnassignedChatters(shift);
        }

        function removeChatterFromGroup(shift, groupId, chatter) {
            const group = shiftAllocations[shift].groups.find(g => g.id === groupId);
            if (group) {
                group.chatters = group.chatters.filter(c => c !== chatter);
                saveData();
                renderGroups(shift);
            }
        }

        function removeGroup(shift, groupId) {
            shiftAllocations[shift].groups = shiftAllocations[shift].groups.filter(g => g.id !== groupId);
            saveData();
            renderGroups(shift);
        }

        function manageChatterModels(shift, groupId, chatterName) {
            const chatterModelsList = chatterModels[chatterName] || [];
            if (!modelVisibility[chatterName]) modelVisibility[chatterName] = {};
            if (!modelSlowExclude[chatterName]) modelSlowExclude[chatterName] = {};
            
            const chatterPrefs = modelVisibility[chatterName];
            const chatterSlowPrefs = modelSlowExclude[chatterName];

            let modelsHTML = chatterModelsList.map((modelData, index) => {
                const modelName = modelData.model;
                const isVisible = chatterPrefs[modelName] === undefined ? true : chatterPrefs[modelName];
                const isSlowExcluded = chatterSlowPrefs[modelName] === true;
                const t = modelTargets[modelName] || DEFAULT_TARGETS;

                return `
                <div class="bg-gray-50 p-3 rounded-md border border-gray-200">
                    <div class="flex justify-between items-center mb-2 flex-wrap gap-2">
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input type="checkbox" class="form-checkbox h-5 w-5 text-[#5D5CDE] rounded model-visible-check" data-model-name="${modelName}" ${isVisible ? 'checked' : ''}>
                            <span class="text-gray-800 font-semibold">${modelName}</span>
                        </label>
                        <div class="flex items-center gap-2">
                            <label class="flex items-center gap-1 text-xs text-red-700 bg-red-50 px-2 py-1 rounded border border-red-200 cursor-pointer select-none" title="Exclude from slow response time detection alerts">
                                <input type="checkbox" class="form-checkbox h-3.5 w-3.5 text-red-600 rounded model-slow-exclude-check" data-model-name="${modelName}" ${isSlowExcluded ? 'checked' : ''}>
                                <span>Exclude Slow Alert</span>
                            </label>
                            <button onclick="toggleTargetEdit('target-edit-${index}')" class="text-xs bg-purple-100 hover:bg-purple-200 text-purple-700 px-2 py-1 rounded border border-purple-300">📉 Targets</button>
                        </div>
                    </div>
                    <div id="target-edit-${index}" class="hidden mt-2 pt-2 border-t border-gray-200 grid grid-cols-2 gap-2 text-xs">
                        <div class="col-span-2 mb-1 font-bold text-gray-500">Target per 2-Hr Quarter</div>
                        <div><label class="block text-gray-600">Messages</label><input type="number" class="w-full border border-gray-300 rounded px-1 py-1" id="t-msg-${index}" value="${t.messagesSent}"></div>
                        <div><label class="block text-gray-600">Fans</label><input type="number" class="w-full border border-gray-300 rounded px-1 py-1" id="t-fan-${index}" value="${t.fansChatted}"></div>
                        <div><label class="block text-gray-600">PPVs Sent</label><input type="number" class="w-full border border-gray-300 rounded px-1 py-1" id="t-ppvs-${index}" value="${t.ppvsSent}"></div>
                        <div><label class="block text-gray-600">PPVs Open</label><input type="number" class="w-full border border-gray-300 rounded px-1 py-1" id="t-ppvo-${index}" value="${t.ppvsOpen}"></div>
                        <div><label class="block text-gray-600">Resp Time</label><input type="number" class="w-full border border-gray-300 rounded px-1 py-1" id="t-resp-${index}" value="${t.responseTime}"></div>
                        <div><label class="block text-gray-600">Revenue</label><input type="number" class="w-full border border-gray-300 rounded px-1 py-1" id="t-rev-${index}" value="${t.revenue}"></div>
                        <button onclick="saveSpecificTarget('${modelName}', ${index})" class="col-span-2 mt-2 bg-green-500 hover:bg-green-600 text-white py-1 rounded">Save Targets</button>
                    </div>
                </div>`;
            }).join('');

            if (chatterModelsList.length === 0) modelsHTML = '<p class="text-sm text-gray-500">No models found for this chatter.</p>';

            const modal = document.createElement('div');
            modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            modal.id = 'model-manage-modal';
            modal.innerHTML = `
                <div class="bg-white p-6 rounded-lg shadow-lg max-w-md w-full mx-4 flex flex-col max-h-[85vh]">
                    <div class="flex justify-between items-center mb-2"><h3 class="text-lg font-semibold text-gray-900">Manage Models: ${chatterName}</h3><button onclick="this.closest('.fixed').remove()" class="text-gray-500 hover:text-gray-700 text-xl">&times;</button></div>
                    <p class="text-xs text-gray-500 mb-4">Uncheck models to hide them. Check <b>"Exclude Slow Alert"</b> to skip free pages from slow response time detection.</p>
                    <div class="space-y-3 overflow-y-auto flex-1 pr-2" id="model-checkbox-list">${modelsHTML}</div>
                    <div class="flex justify-end gap-3 mt-4 pt-3 border-t border-gray-100"><button class="px-4 py-2 bg-[#5D5CDE] text-white hover:bg-[#4D4CCE] rounded w-full" onclick="saveModelVisibility('${chatterName}')">Done</button></div>
                </div>`;
            document.body.appendChild(modal);
        }

        window.toggleTargetEdit = function(id) { 
            const el = document.getElementById(id);
            if (el) el.classList.toggle('hidden'); 
        }

        window.saveSpecificTarget = function(modelName, index) {
            modelTargets[modelName] = {
                messagesSent: parseInt(document.getElementById(`t-msg-${index}`).value) || 0,
                fansChatted: parseInt(document.getElementById(`t-fan-${index}`).value) || 0,
                ppvsSent: parseInt(document.getElementById(`t-ppvs-${index}`).value) || 0,
                ppvsOpen: parseInt(document.getElementById(`t-ppvo-${index}`).value) || 0,
                revenue: parseInt(document.getElementById(`t-rev-${index}`).value) || 0,
                responseTime: parseFloat(document.getElementById(`t-resp-${index}`).value) || 0
            };
            saveData();
            if (allocationsLocked) generateReport();
            const btn = document.querySelector(`#target-edit-${index} button`);
            if (btn) {
                const originalText = btn.textContent;
                btn.textContent = "Saved!";
                btn.classList.add('bg-green-700');
                setTimeout(() => { btn.textContent = originalText; btn.classList.remove('bg-green-700'); }, 1500);
            }
        }

        function saveModelVisibility(chatterName) {
            const prefs = {};
            document.querySelectorAll('.model-visible-check').forEach(checkbox => prefs[checkbox.dataset.modelName] = checkbox.checked);
            modelVisibility[chatterName] = prefs;

            const slowPrefs = {};
            document.querySelectorAll('.model-slow-exclude-check').forEach(checkbox => slowPrefs[checkbox.dataset.modelName] = checkbox.checked);
            modelSlowExclude[chatterName] = slowPrefs;

            const modal = document.getElementById('model-manage-modal');
            if (modal) modal.remove();
            saveData();
            if (allocationsLocked) generateReport();
        }

        document.querySelectorAll('.shift-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                const shift = this.dataset.shift;
                document.querySelectorAll('.shift-tab').forEach(t => { t.classList.remove('bg-[#5D5CDE]', 'text-white'); t.classList.add('text-gray-600'); });
                this.classList.add('bg-[#5D5CDE]', 'text-white'); this.classList.remove('text-gray-600');
                document.querySelectorAll('.shift-content').forEach(c => c.classList.add('hidden'));
                const content = document.getElementById(`shift-${shift}-content`);
                if (content) content.classList.remove('hidden');
            });
        });

        function generateReport() {
            const resultsContainer = document.getElementById('results-container');
            const results = document.getElementById('results');
            const allocationSection = document.getElementById('allocation-section');
            if (!resultsContainer || !results || !allocationSection) return;
            
            resultsContainer.innerHTML = '';
            const quarters = ['q1', 'q2', 'q3', 'q4'];

            const quarterLabels = ['Q1', 'Q2', 'Q3', 'Q4'];

            for (let shift = 1; shift <= 3; shift++) {
                if (shiftAllocations[shift].groups.length === 0) continue;
                let shiftHTML = `<div class="page-break-after mb-6"><h2 class="text-xl font-bold text-gray-900 mb-3 pb-1 border-b-2 border-[#5D5CDE]">Shift ${shift}</h2>`;

                shiftAllocations[shift].groups.forEach((group, groupIndex) => {
                    const groupReportId = `group-report-${shift}-${group.id}`;
                    const safeFilename = `${group.name.replace(/[^a-z0-9]/gi, '_').toLowerCase()}`;
                    const safeManagerName = `${group.manager.replace(/[^a-z0-9]/gi, '_').toLowerCase()}`;
                    const groupBgClass = groupIndex % 2 === 0 ? 'bg-gray-50' : 'bg-blue-50';
                    shiftHTML += `
                        <div id="${groupReportId}" class="mb-12 p-3 ${groupBgClass} rounded border-8 border-black">
                            <div class="mb-2 pb-1 border-b border-gray-300 flex justify-between items-center">
                                <h3 class="text-lg font-bold text-[#5D5CDE] w-1/3">${group.name}</h3>
                                <div class="w-1/3 text-center"><span class="text-xl font-semibold text-gray-700">Manager: ${group.manager}</span></div>
                                <div class="flex gap-2 no-print w-1/3 justify-end">
                                    <button onclick="downloadAllSections(this, '${groupReportId}', '${safeFilename}', '${safeManagerName}')" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold py-1 px-2 rounded">Download All Sections</button>
                                    <button onclick="copyGroupImage(this, '${groupReportId}')" class="bg-green-500 hover:bg-green-600 text-white text-xs font-semibold py-1 px-2 rounded">Copy All (Full)</button>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 gap-2">`;

                    const chattersPerSection = 5;
                    let chatterBuffer = '';
                    group.chatters.forEach((chatter, chatterIndex) => {
                        if (chatterModels[chatter]) {
                            const allChatterModels = chatterModels[chatter];
                            const visibility = modelVisibility[chatter] || {};
                            const visibleModels = allChatterModels.filter(m => visibility[m.model] === undefined ? true : visibility[m.model]);
                            if (visibleModels.length > 0) chatterBuffer += createChatterTable(chatter, visibleModels, quarterLabels);
                        }
                        if ((chatterIndex + 1) % chattersPerSection === 0 || chatterIndex === group.chatters.length - 1) {
                            const sectionIndex = Math.floor(chatterIndex / chattersPerSection);
                            const sectionId = `${groupReportId}-section-${sectionIndex}`;
                            shiftHTML += `<div id="${sectionId}" class="mb-4 p-3 bg-gray-100 rounded border border-gray-300 relative">
                                <div class="export-header hidden mb-4 p-4 bg-[#5D5CDE] text-white text-center rounded-t shadow-md border-b-4 border-[#220e30]">
                                    <h1 class="text-3xl font-bold uppercase tracking-wider">${group.name}</h1>
                                    <h2 class="text-xl font-semibold mt-1 opacity-90">Manager: ${group.manager}</h2>
                                </div>
                                ${chatterBuffer}
                                <div class="flex gap-2 justify-end no-print mt-2 -mr-1 -mb-1">
                                    <button onclick="downloadGroupImage(this, '${sectionId}', '${safeFilename}_sect${sectionIndex+1}')" class="bg-blue-500 hover:bg-blue-600 text-white text-xs font-semibold py-1 px-2 rounded">Download</button>
                                    <button onclick="copyGroupImage(this, '${sectionId}')" class="bg-green-500 hover:bg-green-600 text-white text-xs font-semibold py-1 px-2 rounded">Copy</button>
                                </div></div>`;
                            chatterBuffer = '';
                        }
                    });
                    shiftHTML += `</div></div>`;
                });
                shiftHTML += `</div>`;
                resultsContainer.innerHTML += shiftHTML;
            }
            allocationSection.classList.add('hidden');
            results.classList.remove('hidden');
        }

        // --- EXPORT FUNCTIONS ---
        function generateGroupBlob(elementId) {
            return new Promise((resolve, reject) => {
                const element = document.getElementById(elementId);
                if (!element) return reject(new Error('Element not found'));
                const originalBg = element.style.backgroundColor;
                const originalFontSize = element.style.fontSize;
                element.style.backgroundColor = '#ffffff'; element.style.fontSize = '18pt';
                element.querySelectorAll('.no-print').forEach(btn => btn.style.display = 'none');
                html2canvas(element, {
                    scale: 4, useCORS: true, window: window,
                    onclone: (clonedDoc) => {
                        const clonedElement = clonedDoc.getElementById(elementId);
                        if (clonedElement) {
                            clonedElement.style.backgroundColor = originalBg; 
                            clonedElement.style.fontSize = '18pt';
                            const header = clonedElement.querySelector('.export-header');
                            if (header) { header.classList.remove('hidden'); header.style.display = 'block'; }
                        }
                        clonedDoc.querySelectorAll('.no-print').forEach(btn => btn.style.display = 'none');
                    }
                }).then(canvas => {
                    element.style.backgroundColor = originalBg; element.style.fontSize = originalFontSize;
                    element.querySelectorAll('.no-print').forEach(btn => btn.style.display = '');
                    canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error('Canvas failed')), 'image/png');
                }).catch(err => {
                    element.style.backgroundColor = originalBg; element.style.fontSize = originalFontSize;
                    element.querySelectorAll('.no-print').forEach(btn => btn.style.display = '');
                    reject(err);
                });
            });
        }

        async function downloadAllSections(buttonEl, groupReportId, groupName, managerName) {
            const originalText = buttonEl.innerHTML;
            buttonEl.disabled = true;
            try {
                const groupElement = document.getElementById(groupReportId);
                if (!groupElement) throw new Error('Group report not found');
                const sectionElements = groupElement.querySelectorAll(`[id^="${groupReportId}-section-"]`);
                if (sectionElements.length === 0) { showCustomAlert('No sections found.'); return; }
                for (let i = 0; i < sectionElements.length; i++) {
                    buttonEl.innerHTML = `... (${i+1}/${sectionElements.length})`;
                    const blob = await generateGroupBlob(sectionElements[i].id);
                    const link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = `${groupName}_${managerName}_section_${i+1}.png`;
                    document.body.appendChild(link); link.click(); document.body.removeChild(link); URL.revokeObjectURL(link.href);
                    await new Promise(resolve => setTimeout(resolve, 300));
                }
            } catch (err) { console.error(err); showCustomAlert('Download error.'); } 
            finally { buttonEl.innerHTML = originalText; buttonEl.disabled = false; }
        }

        async function downloadGroupImage(buttonEl, elementId, filename) {
            const originalText = buttonEl.innerHTML; buttonEl.innerHTML = '...'; buttonEl.disabled = true;
            try {
                const blob = await generateGroupBlob(elementId);
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = filename + ".png";
                document.body.appendChild(link); link.click(); document.body.removeChild(link); URL.revokeObjectURL(link.href);
            } catch (err) { console.error(err); showCustomAlert('Download error.'); }
            finally { buttonEl.innerHTML = originalText; buttonEl.disabled = false; }
        }

        async function copyGroupImage(buttonEl, elementId) {
            if (!navigator.clipboard || !navigator.clipboard.write) { showCustomAlert('Clipboard not supported.'); return; }
            const originalText = buttonEl.innerHTML; buttonEl.innerHTML = '...'; buttonEl.disabled = true;
            try {
                const blob = await generateGroupBlob(elementId);
                await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
                showCustomAlert('Copied to clipboard!');
            } catch (err) { console.error(err); showCustomAlert('Copy error.'); }
            finally { buttonEl.innerHTML = originalText; buttonEl.disabled = false; }
        }

        function showAllocationSection() {
            document.getElementById('allocation-section').classList.remove('hidden');
            document.getElementById('results').classList.add('hidden');
        }

        function showCustomAlert(message) {
            const modal = document.createElement('div');
            modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            modal.innerHTML = `
                <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full mx-4">
                    <p class="text-gray-700 mb-4">${message}</p>
                    <div class="flex justify-end"><button class="px-4 py-2 bg-[#5D5CDE] text-white hover:bg-[#4D4CCE] rounded" onclick="this.closest('.fixed').remove()">OK</button></div>
                </div>`;
            document.body.appendChild(modal);
        }

        function clearAll() {
            const modal = document.createElement('div');
            modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            modal.innerHTML = `
                <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full mx-4">
                    <p class="text-gray-700 mb-4 font-semibold">Clear everything?</p>
                    <p class="text-gray-600 text-sm mb-4">This will wipe all data from memory.</p>
                    <div class="flex justify-end gap-3">
                        <button class="px-4 py-2 bg-gray-500 text-white hover:bg-gray-600 rounded" onclick="this.closest('.fixed').remove()">Cancel</button>
                        <button class="px-4 py-2 bg-red-500 text-white hover:bg-red-600 rounded" onclick="confirmClearAll(); this.closest('.fixed').remove()">Clear All</button>
                    </div>
                </div>`;
            document.body.appendChild(modal);
        }

        function confirmClearAll() {
            const q1 = document.getElementById('file-q1'); if (q1) q1.value = ''; 
            const q2 = document.getElementById('file-q2'); if (q2) q2.value = '';
            const q3 = document.getElementById('file-q3'); if (q3) q3.value = ''; 
            const q4 = document.getElementById('file-q4'); if (q4) q4.value = '';
            
            quarterData = { q1: null, q2: null, q3: null, q4: null };
            
            const q1s = document.getElementById('q1-status'); if (q1s) q1s.textContent = ''; 
            const q2s = document.getElementById('q2-status'); if (q2s) q2s.textContent = '';
            const q3s = document.getElementById('q3-status'); if (q3s) q3s.textContent = ''; 
            const q4s = document.getElementById('q4-status'); if (q4s) q4s.textContent = '';
            
            shiftAllocations[1].groups = []; shiftAllocations[2].groups = []; shiftAllocations[3].groups = [];
            allocationsLocked = false;
            allChatters = []; allModels = {}; chatterModels = {}; modelVisibility = {}; modelTargets = {}; modelSlowExclude = {};
            
            localStorage.removeItem('chatterTrackerData');
            
            const lockBtn = document.getElementById('lock-allocations-btn');
            if (lockBtn) {
                lockBtn.textContent = 'Lock Allocations & View Report';
                lockBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
            
            document.getElementById('allocation-section').classList.add('hidden');
            document.getElementById('results').classList.add('hidden');
            document.getElementById('error-container').classList.add('hidden');
            updateAllocationStatus();
        }

        document.addEventListener('DOMContentLoaded', (event) => {
            loadData();
            const processBtn = document.getElementById('process-btn');
            if (processBtn) processBtn.addEventListener('click', processAllFiles);
            window.addEventListener('beforeunload', function (e) {
                if ((quarterData.q1 || allChatters.length > 0) && !localStorage.getItem('chatterTrackerData')) {
                    e.preventDefault(); e.returnValue = '';
                }
            });
        });
    </script>

</body></html>
