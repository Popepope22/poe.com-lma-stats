<body class="bg-white min-h-screen pb-20">

    <div class="container mx-auto p-4 max-w-7xl">
        
        <div class="mb-6 flex justify-between items-start">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Chatter Performance Tracker</h1>
                <p class="text-gray-600">Track performance with <span class="text-green-600 font-bold">Auto-Save</span>. Close the tab safely; your data will be here when you return.</p>
            </div>
            <div id="save-indicator" class="text-xs text-gray-400 italic transition-opacity duration-500 opacity-0" style="opacity: 0;">Saved to memory</div>
        </div>

        <div id="debug-banner" class="hidden mb-4 p-2 bg-blue-50 text-blue-800 text-xs font-mono border border-blue-200 rounded"></div>

        <div class="bg-gray-50 rounded-lg p-6 mb-6 no-print">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold text-gray-900">1. Upload CSV Files</h2>
                <span id="allocation-status" class="text-sm font-semibold text-green-600"></span>
            </div>
            <p class="text-sm text-gray-600 mb-4">Upload 1-4 CSV files. If you refreshed the page, previous data is marked as "Restored".</p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">Quarter 1 <span id="q1-status" class="text-xs text-blue-600 font-semibold"></span></label>
                    <input type="file" accept=".csv" id="file-q1" class="block w-full text-base px-3 py-2 border border-gray-300 rounded-md bg-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-[#5D5CDE] file:text-white hover:file:bg-[#4D4CCE]">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">Quarter 2 <span id="q2-status" class="text-xs text-blue-600 font-semibold"></span></label>
                    <input type="file" accept=".csv" id="file-q2" class="block w-full text-base px-3 py-2 border border-gray-300 rounded-md bg-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-[#5D5CDE] file:text-white hover:file:bg-[#4D4CCE]">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">Quarter 3 <span id="q3-status" class="text-xs text-blue-600 font-semibold"></span></label>
                    <input type="file" accept=".csv" id="file-q3" class="block w-full text-base px-3 py-2 border border-gray-300 rounded-md bg-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-[#5D5CDE] file:text-white hover:file:bg-[#4D4CCE]">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">Quarter 4 <span id="q4-status" class="text-xs text-blue-600 font-semibold"></span></label>
                    <input type="file" accept=".csv" id="file-q4" class="block w-full text-base px-3 py-2 border border-gray-300 rounded-md bg-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-[#5D5CDE] file:text-white hover:file:bg-[#4D4CCE]">
                </div>
            </div>

            <div class="flex flex-wrap gap-3">
                <button id="process-btn" class="flex-1 bg-[#5D5CDE] hover:bg-[#4D4CCE] text-white font-semibold py-3 px-6 rounded-md transition duration-200">Process Files / Refresh Data</button>
                
                <button onclick="exportPersistence()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-md transition duration-200">Export Backup</button>
                <button onclick="document.getElementById(&#39;import-input&#39;).click()" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold py-3 px-6 rounded-md transition duration-200">Import Backup</button>
                <input type="file" id="import-input" accept=".json" class="hidden" onchange="importPersistence(event)">
                
                <button id="clear-all-btn" onclick="clearAll()" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-3 px-6 rounded-md transition duration-200">Clear All &amp; Reset</button>
            </div>
        </div>

        <div id="allocation-section" class="no-print hidden">
            <div class="bg-gray-50 rounded-lg p-6 mb-6">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">2. Allocate Chatters to Groups</h2>
                
                <div class="flex border-b border-gray-300 mb-6">
                    <button class="shift-tab px-6 py-3 font-semibold text-white bg-[#5D5CDE] rounded-t-lg" data-shift="1">Shift 1</button>
                    <button class="shift-tab px-6 py-3 font-semibold text-gray-600 hover:bg-gray-200 rounded-t-lg" data-shift="2">Shift 2</button>
                    <button class="shift-tab px-6 py-3 font-semibold text-gray-600 hover:bg-gray-200 rounded-t-lg" data-shift="3">Shift 3</button>
                </div>

                <div id="shift-1-content" class="shift-content">
                    <div class="mb-6">
                        <div class="flex gap-3 mb-4">
                            <input type="text" id="shift-1-group-name" placeholder="Group name (e.g., GROUP 1)" class="flex-1 px-4 py-2 text-base border border-gray-300 rounded-md bg-white text-gray-900">
                            <input type="text" id="shift-1-manager-name" placeholder="Manager name (e.g., JAO)" class="flex-1 px-4 py-2 text-base border border-gray-300 rounded-md bg-white text-gray-900">
                            <button onclick="addGroup(1)" class="bg-[#5D5CDE] hover:bg-[#4D4CCE] text-white font-semibold px-6 py-2 rounded-md transition duration-200">Add Group</button>
                        </div>
                        <div id="shift-1-groups" class="space-y-4">
                <div class="bg-white rounded-lg p-4 border-[#5D5CDE] border-2">
                    <div class="flex justify-between items-center mb-3">
                        <div><h4 class="font-bold text-gray-900">Group 1 </h4><p class="text-sm text-gray-600">Manager: Jao/ Bićko 🐳</p></div>
                        <div class="flex gap-2">
                            <button onclick="editGroup(1, 1789193794701)" class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm px-3 py-1 rounded-md">Edit</button>
                            <button onclick="assignChatterToGroup(1, 1789193794701)" class="bg-green-500 hover:bg-green-600 text-white text-sm px-3 py-1 rounded-md">+ Assign</button>
                            <button onclick="removeGroup(1, 1789193794701)" class="bg-red-500 hover:bg-red-600 text-white text-sm px-3 py-1 rounded-md">Remove</button>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Dami
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Dami&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Dami&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Deshan
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Deshan&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Deshan&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Hyle
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Hyle&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Hyle&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Kraken
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Kraken&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Kraken&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Ricci
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Ricci&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Ricci&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Mara
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Mara&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Mara&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Team Pannacotta Vuk
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Team Pannacotta Vuk&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Team Pannacotta Vuk&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Team Pannacotta
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Team Pannacotta&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Team Pannacotta&#39;)" class="hover:text-red-300">×</button>
                            </span><span class="bg-[#5D5CDE] text-white px-3 py-1 rounded-md text-sm flex items-center gap-2">Team Pannacotta Smith
                                <button onclick="manageChatterModels(1, 1789193794701, &#39;Team Pannacotta Smith&#39;)" class="hover:text-yellow-300 text-xs" title="Manage Models &amp; Slow Exclusions">⚙️</button>
                                <button onclick="removeChatterFromGroup(1, 1789193794701, &#39;Team Pannacotta Smith&#39;)" class="hover:text-red-300">×</button>
                            </span>
                    </div>
                </div>
                <div class="bg-white rounded-lg p-4 border-[#5D5CDE] border-2">
                    <div class="flex justify-between items-center mb-3">
                        <div><h4 class="font-bold text-gray-900">Group 2 </h4><p class="text-sm text-gray-600">Manager: Hristiyan</p></div>
                        <div class="flex gap-2">
                            <button onclick="editGroup(1, 1789193803260)" class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm px-3 py-1 rounded-md">Edit</button>
                            <button onclick="assignChatterToGroup(1, 1789193803260)" class="bg-green-500 hover:bg-green-600 text-white text-sm px-3 py-1 rounded-md">+ Assign</button>
                            <button onclick="removeGroup(1, 1789193803260)" class="bg-red-500 hover:bg-red-600 text-white text-sm px-3 py-1 rounded-md">Remove</button>
